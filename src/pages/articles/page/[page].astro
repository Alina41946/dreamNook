---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import SEO from '../../../components/SEO.astro';
import { getCollection } from 'astro:content';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const ARTICLES_PER_PAGE = 6;

  const articles = await getCollection(
    'articles',
    ({ data }) => data.noindex !== true
  );

  articles.sort((a, b) => {
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

  const totalPages = Math.ceil(
    articles.length / ARTICLES_PER_PAGE
  );

  return Array.from(
    { length: Math.max(totalPages - 1, 0) },
    (_, index) => {
      const page = index + 2;

      const start = (page - 1) * ARTICLES_PER_PAGE;
      const end = start + ARTICLES_PER_PAGE;

      return {
        params: {
          page: String(page),
        },
        props: {
          articles: articles.slice(start, end),
          currentPage: page,
          totalPages,
        },
      };
    }
  );
}

const { page } = Astro.params;

const {
  articles,
  currentPage,
  totalPages,
} = Astro.props;

const categories = [
  '全部',
  '語言學習',
  '日本打工',
  '旅遊',
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <SEO
      title={`文章｜第 ${currentPage} 頁｜dreamNook`}
      description="dreamNook 的文章，記錄語言學習、日本打工與旅遊生活。"
    />
  </head>

  <body>
    <Header />

    <main class="articles-page">

      <!-- Page Header -->
      <section class="articles-header">

        <p class="section-label">
          JOURNAL
        </p>

        <h1>
          文章
        </h1>

        <p class="articles-intro">
          記錄生活、旅行、語言學習，
          以及一路上遇見的人與故事。
        </p>

      </section>


      <!-- Category Navigation -->
      <nav
        class="article-category-nav"
        aria-label="文章分類"
      >

        {categories.map((category) => (
          category === '全部' ? (
            <a
              href="/dreamNook/articles/"
              class="article-category-link active"
            >
              {category}
            </a>
          ) : (
            <a
              href={`/dreamNook/articles/category/${category}/`}
              class="article-category-link"
            >
              {category}
            </a>
          )
        ))}

      </nav>


      <!-- Article List -->
      <section class="articles-list">

        {articles.length > 0 ? (
          <div class="article-grid">

            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}

          </div>
        ) : (
          <p class="articles-empty">
            目前還沒有文章。
          </p>
        )}

      </section>


      <!-- Pagination -->
      {totalPages > 1 && (
        <nav
          class="article-pagination"
          aria-label="文章分頁"
        >

          {currentPage > 2 ? (
            <a
              href={`/dreamNook/articles/page/${currentPage - 1}/`}
              aria-label="上一頁"
            >
              ←
            </a>
          ) : (
            <a
              href="/dreamNook/articles/"
              aria-label="上一頁"
            >
              ←
            </a>
          )}


          <a
            href="/dreamNook/articles/"
          >
            1
          </a>


          {Array.from(
            { length: totalPages - 1 },
            (_, index) => index + 2
          ).map((pageNumber) => (
            <a
              href={`/dreamNook/articles/page/${pageNumber}/`}
              class:list={{
                active: pageNumber === currentPage,
              }}
              aria-current={
                pageNumber === currentPage
                  ? 'page'
                  : undefined
              }
            >
              {pageNumber}
            </a>
          ))}


          {currentPage < totalPages && (
            <a
              href={`/dreamNook/articles/page/${currentPage + 1}/`}
              aria-label="下一頁"
            >
              →
            </a>
          )}

        </nav>
      )}

    </main>

    <Footer />
  </body>
</html>