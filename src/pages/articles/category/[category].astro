---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import SEO from '../../../components/SEO.astro';
import { getCollection } from 'astro:content';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const articles = await getCollection(
    'articles',
    ({ data }) => data.noindex !== true
  );

  const categories = [
    '語言學習',
    '日本打工',
    '旅遊',
  ];

  return categories.map((category) => ({
    params: {
      category,
    },
    props: {
      articles: articles
        .filter((article) => article.data.category === category)
        .sort(
          (a, b) =>
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
        ),
    },
  }));
}

const { category } = Astro.params;
const { articles } = Astro.props;

const categories = [
  '全部',
  '語言學習',
  '日本打工',
  '旅遊',
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <SEO
      title={`${category}｜文章｜dreamNook`}
      description={`dreamNook｜${category}相關文章。`}
    />
  </head>

  <body>
    <Header />

    <main class="articles-page">

      <!-- Page Header -->
      <section class="articles-header">

        <p class="section-label">
          JOURNAL
        </p>

        <h1>
          文章
        </h1>

        <p class="articles-intro">
          記錄生活、旅行、語言學習，
          以及一路上遇見的人與故事。
        </p>

      </section>


      <!-- Category Navigation -->
      <nav
        class="article-category-nav"
        aria-label="文章分類"
      >

        {categories.map((item) => (
          item === '全部' ? (
            <a
              href="/dreamNook/articles/"
              class="article-category-link"
            >
              {item}
            </a>
          ) : (
            <a
              href={`/dreamNook/articles/category/${item}/`}
              class:list={[
                'article-category-link',
                {
                  active: item === category,
                },
              ]}
            >
              {item}
            </a>
          )
        ))}

      </nav>


      <!-- Article List -->
      <section class="articles-list">

        {articles.length > 0 ? (
          <div class="article-grid">

            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}

          </div>
        ) : (
          <p class="articles-empty">
            這個分類目前還沒有文章。
          </p>
        )}

      </section>

    </main>
    <Footer />
  </body>
</html>