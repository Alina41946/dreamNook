<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <p class="footer-logo">DREAM NOOK</p>
      <p class="footer-subtitle">小小的我，小小的夢</p>
    </div>


    <nav class="footer-nav" aria-label="頁尾導覽">
      <a href="/dreamNook/">首頁</a>
      <a href="/dreamNook/articles/">文章</a>
      <a href="/dreamNook/privacy/">隱私權政策</a>
    </nav>


    <div class="footer-social" aria-label="社群連結">

      <!-- LINE -->
      <a
        href="#"
        class="footer-social-link"
        aria-label="LINE"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="bi bi-line" aria-hidden="true"></i>
      </a>

      <!-- Instagram -->
      <a
        href="#"
        class="footer-social-link"
        aria-label="Instagram"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="bi bi-instagram" aria-hidden="true"></i>
      </a>

    </div>


    <p class="footer-copyright">
      © {new Date().getFullYear()} DREAM NOOK
    </p>

  </div>
